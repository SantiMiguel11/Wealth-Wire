{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "riamap.json \u2014 SEC-registered advisers on the map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "sec_data_date",
    "width",
    "height",
    "shards",
    "counts",
    "total_aum_usd",
    "focus",
    "services",
    "fields",
    "firms"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "sec_data_date": {
      "type": [
        "string",
        "null"
      ]
    },
    "width": {
      "const": 975
    },
    "height": {
      "const": 610
    },
    "shards": {
      "type": "integer",
      "minimum": 1
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisers",
        "mapped",
        "unmapped",
        "approximate",
        "no_address"
      ],
      "properties": {
        "advisers": {
          "type": "integer",
          "minimum": 0
        },
        "mapped": {
          "type": "integer",
          "minimum": 0
        },
        "unmapped": {
          "type": "integer",
          "minimum": 0
        },
        "approximate": {
          "type": "integer",
          "minimum": 0
        },
        "no_address": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "total_aum_usd": {
      "type": "number",
      "minimum": 0
    },
    "focus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 12,
      "maxItems": 12
    },
    "fields": {
      "const": [
        "crd",
        "name",
        "x",
        "y",
        "aum_usd",
        "city",
        "state",
        "focus",
        "services",
        "flags"
      ]
    },
    "firms": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": [
              "string",
              "null"
            ]
          },
          {
            "type": [
              "string",
              "null"
            ]
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          {
            "type": "integer",
            "minimum": 0
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ],
        "items": false,
        "minItems": 10
      }
    }
  }
}
